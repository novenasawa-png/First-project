{
  "extraKnownMarketplaces": {
    "ai-marketing-hub-claude-ads": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-ads"
      }
    }
  },
  "enabledPlugins": {
    "claude-ads@ai-marketing-hub-claude-ads": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm install --no-audit --no-fund >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
